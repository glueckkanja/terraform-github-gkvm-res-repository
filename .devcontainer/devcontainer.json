{
  "name": "terraform-github-gkvm-res-repository",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest",
      "terragrunt": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "updateRemoteUserUID": true,
  "onCreateCommand": "terraform version && tflint --version",
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "hashicorp.terraform"
      ]
    }
  }
}
